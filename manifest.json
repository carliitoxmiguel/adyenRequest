{
  "manifest_version": 3,
  "name": "Adyen Fallback Payment Form",
  "version": "1.0",
  "description": "Replaces Adyen form with a fallback if Adyen fails to load.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.petsuppliesplus.com/checkout*"],
      "js": ["adyenApi.js", "content.js"]
    }
  ],
  "web_accessible_resources": [{
    "resources": ["adyenApi.js"],
    "matches": ["<all_urls>"]
  }]
}
